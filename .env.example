PORT=3000
PUBLIC_BASE_URL=https://your-public-domain.example

# Infobip
INFOBIP_BASE_URL=w4xkn1.api.infobip.com
INFOBIP_API_KEY=replace_with_rotated_key
INFOBIP_WS_CONFIG_NAME=viber-gemini-live
INFOBIP_WS_SAMPLE_RATE=24000
INFOBIP_WS_SHARED_SECRET=change_me

# Set this after running: npm run setup:infobip-ws
INFOBIP_WS_CONFIG_ID=

# SignalWire
SIGNALWIRE_STREAM_BEARER_TOKEN=change_me_signalwire
SIGNALWIRE_STREAM_CODEC=PCMU@8000h
SIGNALWIRE_STREAM_SAMPLE_RATE=8000

# Telnyx
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER_ID=
TELNYX_TEXML_APP_ID=
TELNYX_STREAM_TOKEN=
TELNYX_STREAM_CODEC=PCMU
TELNYX_STREAM_SAMPLE_RATE=8000
TELNYX_STREAM_TRACK=inbound_track
TELNYX_SPEECH_THRESHOLD=450
TELNYX_GREETING_AUDIO_PATH=assets/telnyx-greeting.wav
TELNYX_GREETING=Dạ em chào anh chị. Anh chị cần tư vấn sản phẩm nào ạ?

# Gemini
GEMINI_API_KEY=replace_with_rotated_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Aoede
GEMINI_LANGUAGE_CODE=vi-VN
GEMINI_INPUT_SAMPLE_RATE=16000
PRODUCT_KNOWLEDGE_PATH=product.md
GEMINI_INITIAL_GREETING=Hãy chào khách bằng tiếng Việt và hỏi khách cần tư vấn sản phẩm nào. Nói ngắn gọn.
GEMINI_SYSTEM_INSTRUCTION=Bạn là trợ lý AI trả lời cuộc gọi bằng tiếng Việt. Trả lời ngắn gọn, tự nhiên, hỏi lại khi thiếu thông tin.
