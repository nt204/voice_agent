# Gemini
GEMINI_API_KEY=replace_with_rotated_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_ORDER_EXTRACTION_ENABLED=true
GEMINI_ORDER_EXTRACTION_TIMEOUT_SECONDS=12
GEMINI_RATE_LIMIT_RETRY_MAX_DELAY_SECONDS=60
GEMINI_VOICE_NAME=Aoede
GEMINI_LANGUAGE_CODE=my-MM
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.7
GEMINI_MAX_OUTPUT_TOKENS=400
GEMINI_SECONDARY_ASR_ENABLED=false
GEMINI_IN_CALL_SECONDARY_ASR_ENABLED=true
GEMINI_SECONDARY_ASR_MODEL=gemini-2.5-flash
GEMINI_SECONDARY_ASR_LANGUAGE_PRIORITY=Burmese, Myanmar English
PRODUCT_KNOWLEDGE_PATH=product.md
GEMINI_INITIAL_GREETING=မင်္ဂလာပါရှင်။ Venus BigOne ကပါ။ ဘာအကြောင်း အကြံပြုပေးရမလဲရှင်။
GEMINI_INBOUND_INITIAL_GREETING=မင်္ဂလာပါရှင်။ Venus BigOne ကပါ။ ဘာအကြောင်း အကြံပြုပေးရမလဲရှင်။
GEMINI_OUTBOUND_INITIAL_GREETING=မင်္ဂလာပါရှင်။ Venus BigOne က ဆက်သွယ်တာပါ။ အခု ခဏပြောလို့ရမလားရှင်။
