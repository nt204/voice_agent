PORT=3000
PUBLIC_BASE_URL=https://your-public-domain.example

# Infobip
INFOBIP_BASE_URL=w4xkn1.api.infobip.com
INFOBIP_API_KEY=replace_with_rotated_key
INFOBIP_WS_CONFIG_NAME=viber-gemini-live
INFOBIP_WS_SAMPLE_RATE=24000
INFOBIP_WS_SHARED_SECRET=change_me

# Set this after running: npm run setup:infobip-ws
INFOBIP_WS_CONFIG_ID=

# SignalWire
SIGNALWIRE_STREAM_BEARER_TOKEN=change_me_signalwire
SIGNALWIRE_STREAM_CODEC=PCMU@8000h
SIGNALWIRE_STREAM_SAMPLE_RATE=8000

# Telnyx
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_PHONE_NUMBER_ID=
TELNYX_TEXML_APP_ID=
TELNYX_OUTBOUND_FROM_NUMBER=
TELNYX_OUTBOUND_CALL_TIMEOUT_SECONDS=15
TELNYX_STREAM_TOKEN=
TELNYX_STREAM_CODEC=PCMU
TELNYX_STREAM_SAMPLE_RATE=8000
TELNYX_STREAM_TRACK=inbound_track
TELNYX_SPEECH_THRESHOLD=50
TELNYX_MIN_VOICE_MS=100
TELNYX_SILENCE_MS=1200
TELNYX_SPEECH_START_FRAMES=5
TELNYX_SPEECH_END_SILENCE_FRAMES=60
TELNYX_ADAPTIVE_THRESHOLD=true
TELNYX_NOISE_MULTIPLIER=3.0
TELNYX_NOISE_MARGIN=80
TELNYX_BARGE_IN_THRESHOLD=900
TELNYX_ECHO_SUPPRESSION_MS=700
TELNYX_PAUSE_LENGTH_SECONDS=600
TELNYX_OUTBOUND_GREETING_DELAY_SECONDS=2
TELNYX_GREETING_AUDIO_PATH=assets/telnyx-greeting.wav
TELNYX_GREETING=မင်္ဂလာပါ။ ဆိုင်ရဲ့ အကြံပေးအကူအညီဖြစ်ပါတယ်။ ဘယ်လိုကူညီပေးရမလဲရှင်။

# Gemini
GEMINI_API_KEY=replace_with_rotated_key
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Aoede
GEMINI_LANGUAGE_CODE=my-MM
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.7
GEMINI_MAX_OUTPUT_TOKENS=400
PRODUCT_KNOWLEDGE_PATH=product.md
GEMINI_INITIAL_GREETING=မင်္ဂလာပါ။ ဆိုင်ရဲ့ အကြံပေးအကူအညီဖြစ်ပါတယ်။ ဘယ်လိုကူညီပေးရမလဲရှင်။
GEMINI_SYSTEM_INSTRUCTION=သင်သည် ဖုန်းဖြင့် မြန်မာဘာသာသာ ပြောဆိုသော အရောင်းအကြံပေး AI ဖြစ်သည်။ ဖောက်သည် မည်သည့်ဘာသာဖြင့်မေးမေး အဓိပ္ပါယ်နားလည်ပြီး မြန်မာစာဖြင့်သာ ဖြေပါ။
